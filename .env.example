# Copia este archivo a .env y llénalo. NUNCA subas .env a GitHub.

# Dominio público con HTTPS. Sin dominio propio usa la IP de tu VM con sslip.io, ej: 34-56-78-90.sslip.io
DOMINIO=

# --- WhatsApp Cloud API (Meta for Developers) ---
VERIFY_TOKEN=elige_un_token_secreto
WHATSAPP_ACCESS_TOKEN=          # token PERMANENTE de un usuario del sistema (Meta Business Suite)
PHONE_NUMBER_ID=
WABA_TOKEN_ID=
WHATSAPP_APP_SECRET=            # Configuración de la app > Básica > Clave secreta (verifica la firma de Meta)

# --- Prompt Guard (repo restringido: acepta la licencia en Hugging Face) ---
HF_TOKEN=

# --- Opcionales ---
MODO_SIMULACION=0
UMBRAL_PROMPT_GUARD=0.5
UMBRAL_GUIA=0.30
UMBRAL_P95_S=30
UMBRAL_TASA_ERROR=0.05
